# Supabase Dashboard > Project Settings > API. Chave publicável, nunca service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave privada (sb_secret_...) SOMENTE no servidor, para persistir XML já validado.
# Nunca prefixe com NEXT_PUBLIC_ nem compartilhe esta chave em chat/commits.
SUPABASE_SECRET_KEY=
# Demonstração é iniciada por `npm run demo`, exclusivamente em desenvolvimento local.
# Não habilite ERP_LOCAL_DEMO em produção.
